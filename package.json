{
	"name": "agentic-scraper",
	"version": "0.1.0",
	"description": "An agentic structured web-research and data-extraction service.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"start": "node --env-file=.env dist/server.js",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.7",
		"hono": "^4.7.11",
		"pino": "^9.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^22.15.29",
		"typescript": "^5.8.3",
		"vitest": "^3.2.3"
	}
}
